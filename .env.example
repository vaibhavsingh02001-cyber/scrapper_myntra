# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_EXTRACTION_MODEL=llama3-70b-8192
GROQ_QUERY_MODEL=llama3-8b-8192

# Database & Persistence
DATABASE_URL=sqlite:///./scapper.db

# Storage Paths
STORAGE_PATH=./backend/storage

# API Server Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Scraper & Execution Rules
MAX_RETRIES=3
REQUEST_TIMEOUT=30
MAX_TOKENS_PER_CHUNK=6000

# Reddit PRAW API (optional — skip Reddit collection if not set)
# Create at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=MyntraDiscoveryEngine/1.0 by YourUsername
